# Ignore datasets
data/raw/*
!data/processed/*.csv  # (optional: allow small processed ones)
data/*

# Ignore secrets
*.env
*.key
*.pem

# Ignore model files
models/*.pkl
models/*.npy
models/*.csv
models/*.ckpt
models/*.xlsx
models/*.txt
models/*.log


model/*.pkl
model/*.npy
model/*.csv
model/*.ckpt
model/*.xlsx
model/*.txt
model/*.log




# ===========================
#  Anti-Phish-AI Git Ignore
# ===========================

# Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.log

# Virtual environments
venv/
env/
*.egg-info/
.pytorch_env/
.idea/
.vscode/

# Datasets and processed data
data/
datasets/
*.csv
*.json
*.xlsx

# Models and checkpoints
model/
models/
checkpoints/
*.h5
*.pt
*.pth

# Plots, outputs, and reports
plots/
outputs/
reports/
*.png
*.jpg
*.svg
*.pdf

# OS files
.DS_Store
Thumbs.db
.pyc